{
  "name": "specky-lint",
  "version": "0.1.0",
  "description": "A linter and validator for Specky specifications, ensuring adherence to format and structure.",
  "main": "dist/cli/index.js",
  "bin": {
    "specky-lint": "./dist/cli/index.js"
  },
  "directories": {
    "doc": "docs",
    "man": "man",
    "test": "test"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "start": "ts-node src/cli/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "specky",
    "linter",
    "validator"
  ],
  "author": "James Barnes",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/specky-pm/lint.git"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.0",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.14",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.14.1",
    "@types/semver": "^7.7.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "chalk": "^4.1.2",
    "commander": "^13.1.0",
    "fs-extra": "^11.3.0",
    "gherkin": "^9.0.0",
    "glob": "^11.0.2",
    "marked": "^15.0.10",
    "semver": "^7.7.1",
    "zod": "^3.24.3"
  }
}
